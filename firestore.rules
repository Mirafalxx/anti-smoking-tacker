rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /users/{uid} {
   allow read: if owner(uid);
   allow create: if owner(uid) && request.resource.data.keys().hasOnly(['timeZone']) && request.resource.data.timeZone is string && request.resource.data.timeZone.size() < 100;
   allow update, delete: if false;
   match /events/{eventId} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid)
      && request.resource.data.keys().hasAll(['id','day','at','createdAt'])
      && request.resource.data.keys().hasOnly(['id','day','at','createdAt'])
      && request.resource.data.id == eventId
      && request.resource.data.day is string
      && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && request.resource.data.at is string && request.resource.data.at.size() == 24
      && request.resource.data.createdAt is string && request.resource.data.createdAt.size() == 24;
   }
   match /zeros/{day} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['day']) && request.resource.data.day == day && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
   }
  }
 }
}
